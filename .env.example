HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

UPSTREAM_BASE=https://spotisaver.net
DEFAULT_LANG=en
REQUEST_TIMEOUT_MS=25000
MAX_RETRIES=2

# Optional outbound proxy (needed when hosting on a datacenter IP that the
# upstream Cloudflare blocks). Format: http://user:pass@host:port
PROXY_URL=

# Optional transparent relay for blocked datacenter hosts. Render defaults to a
# temporary residential tunnel; set empty to disable or point at your own relay.
UPSTREAM_RELAY=
RELAY_KEY=

SESSION_POOL_SIZE=8
MAX_CONCURRENT=16
SIGNATURE_TTL_SKEW_MS=15000

# Download backend (slot-limited upstream). Keep concurrency low.
DOWNLOAD_CONCURRENCY=2
DOWNLOAD_RETRIES=4
DOWNLOAD_RETRY_DELAY_MS=4000
DOWNLOAD_WAIT_MS=90000
# Your public IP; some upstream slot checks prefer it. Empty = omit.
USER_IP=

CACHE_TTL_MS=600000
CACHE_STALE_MS=3600000
CACHE_MAX=2000

BATCH_CONCURRENCY=8
BATCH_MAX_IDS=25

# Comma separated API keys. Empty = auth disabled (dev only).
API_KEYS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
CORS_ORIGIN=*
